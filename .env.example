# ===================================
# NIPS — Network Intrusion Prevention System
# ===================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 根据需要修改下面的值

# ===================================
# 应用配置
# ===================================
# 应用端口（默认8000）
APP_PORT=8000

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
